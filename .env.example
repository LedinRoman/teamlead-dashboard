# Copy to .env. Never commit .env.

### APP
APP_NAME="teamlead-dashboard"
APP_PORT=3000
APP_IS_PRODUCTION=false

### DATABASE
# Local default is SQLite, so `npm run dev` needs nothing else.
# `docker compose up` forces Postgres and ignores DB_CLIENT here.
DB_CLIENT="sqlite"
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_USERNAME="postgres"
DB_PASSWORD="password"
DB_DATABASE="teamlead"

# Optional 32-byte base64 key for the stored Jira token.
# If empty, the app creates one on first start and keeps it in the database.
# METRICS_DASHBOARD_KEY=""
